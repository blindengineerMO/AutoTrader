# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Auth
JWT_SECRET=change-me-to-a-long-random-string
CREDENTIAL_ENCRYPTION_KEY=
DEFAULT_ADMIN_EMAILS=admin@autotrader.local
DEFAULT_ADMIN_PASSWORD=ChangeMeAdmin123!
DEFAULT_ADMIN_RESET_PASSWORD=false

# AI strategy providers (the app falls back to a rules-based plan when these are unavailable)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Market data (web scraping fallback is used when this is unavailable)
FINNHUB_API_KEY=
# One Census key is used by Census BFS, BDS, and retail/trade data-source providers.
SEC_EDGAR_USER_AGENT=AutoTrader research contact@example.com
CENSUS_API_KEY=
GDELT_DOC_ENABLED=true
GDELT_DOC_MAX_RECORDS=100
BEA_API_KEY=
BLS_API_KEY=
EIA_API_KEY=
USDA_AMS_API_KEY=

# Alpaca Trading API (paper trading is the default safety posture)
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Stripe billing (reserved for the upcoming paid signup/billing workflow)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DEFAULT_PRICE_ID=
STRIPE_BILLING_PORTAL_RETURN_URL=

# Trading safety
DAILY_LOSS_LIMIT_USD=10
MAX_TRADES_PER_SYMBOL_PER_24H=3
TRADING_ENABLED=false

# Rate limiting & retry (Phase 83)
FINNHUB_RATE_PER_MIN=58
SEARCH_RATE_PER_MIN=30
SOURCE_RATE_PER_MIN=60
HTTP_RETRY_MAX=4
HTTP_RETRY_BASE_DELAY_MS=500

# Search providers (Phase 84) — comma-separated; default rotates google,google-news,bing,mojeek,dogpile,duckduckgo-html
SEARCH_PROVIDERS=

# Local-LLM research reasoning & idle background research (Phase 86)
OLLAMA_RESEARCH_REASONING_ENABLED=true
IDLE_RESEARCH_ENABLED=true
IDLE_RESEARCH_CADENCE_CRON=15 * * * *
IDLE_RESEARCH_MAX_COMPANIES_PER_TICK=3
