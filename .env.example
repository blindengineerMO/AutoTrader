# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Auth
JWT_SECRET=change-me-to-a-long-random-string
CREDENTIAL_ENCRYPTION_KEY=
DEFAULT_ADMIN_EMAILS=admin@autotrader.local
DEFAULT_ADMIN_PASSWORD=ChangeMeAdmin123!
DEFAULT_ADMIN_RESET_PASSWORD=false

# AI strategy providers (the app falls back to a rules-based plan when these are unavailable)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Market data (web scraping fallback is used when this is unavailable)
FINNHUB_API_KEY=
# One Census key is used by Census BFS and Census BDS data-source providers.
SEC_EDGAR_USER_AGENT=AutoTrader research contact@example.com
CENSUS_API_KEY=
GDELT_DOC_ENABLED=true
GDELT_DOC_MAX_RECORDS=100

# Alpaca Trading API (paper trading is the default safety posture)
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Trading safety
DAILY_LOSS_LIMIT_USD=10
MAX_TRADES_PER_SYMBOL_PER_24H=3
TRADING_ENABLED=false
